# Copier ce fichier en .env et renseigner la chaîne de connexion PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/app_db
SEED_ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-chars
SEED_MANAGER_PASSWORD=replace-with-a-private-password-at-least-12-chars
SEED_AGENT_PASSWORD=replace-with-a-private-password-at-least-12-chars

# Synchronisation en lecture seule du registre media-salam (compte super administrateur).
# Facultatif : sans ces variables, l'import manuel de la sauvegarde JSON reste disponible.
MEDIA_SALAM_URL=https://media-salam.vercel.app
MEDIA_SALAM_USERNAME=
MEDIA_SALAM_PASSWORD=
# Même secret que SALAM_LIBRARY_WEBHOOK_SECRET dans le projet Media Salam.
# Permet les notifications signées lors d'une création ou modification d'abonné.
MEDIA_SALAM_WEBHOOK_SECRET=
# Secret partagé avec le cron Vercel (obligatoire pour la synchronisation quotidienne).
CRON_SECRET=replace-with-a-random-secret-at-least-32-chars
